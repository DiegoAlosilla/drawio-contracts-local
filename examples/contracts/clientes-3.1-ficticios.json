{
  "openapi": "3.1.2",
  "info": {"title": "API de clientes de demostración", "version": "1.0.0"},
  "security": [{"demoKey": []}],
  "paths": {
    "/clientes/{clienteId}": {
      "parameters": [
        {"$ref": "#/components/parameters/clienteId"},
        {"name": "detalle", "in": "query", "schema": {"type": "boolean", "default": false}},
        {"name": "X-Demo", "in": "header", "schema": {"type": "string"}},
        {"name": "sesionFicticia", "in": "cookie", "schema": {"type": "string"}}
      ],
      "get": {
        "operationId": "consultarCliente",
        "summary": "Consultar cliente ficticio",
        "parameters": [{"name": "detalle", "in": "query", "required": true, "schema": {"type": "boolean"}}],
        "responses": {
          "200": {"$ref": "#/components/responses/Cliente", "description": "Resultado ficticio específico de consulta"},
          "4XX": {"description": "Error ficticio del cliente"},
          "default": {"description": "Otro resultado ficticio"}
        }
      },
      "patch": {
        "operationId": "actualizarCliente", "summary": "Actualizar nombre ficticio", "security": [],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Persona", "description": "Restricciones locales", "maxProperties": 2}, "example": {"nombre": "Persona ficticia"}}}},
        "responses": {"200": {"$ref": "#/components/responses/Cliente"}, "400": {"description": "Solicitud ficticia inválida"}, "default": {"description": "Otro resultado ficticio"}}
      }
    },
    "/clientes": {
      "post": {
        "summary": "Crear cliente ficticio", "operationId": "crearCliente", "security": [{}],
        "requestBody": {"content": {"application/json": {"schema": {"oneOf": [{"$ref": "#/components/schemas/Persona"}, false]}}}},
        "responses": {"201": {"description": "Cliente ficticio creado"}}
      }
    }
  },
  "components": {
    "parameters": {"clienteId": {"name": "clienteId", "in": "path", "required": true, "schema": {"type": "string"}}},
    "securitySchemes": {"demoKey": {"type": "apiKey", "in": "header", "name": "X-Ficticio"}},
    "responses": {"Cliente": {"description": "Respuesta ficticia base", "headers": {"X-Revision": {"schema": {"type": "string"}}, "Content-Type": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Persona"}, "examples": {"demo": {"$ref": "#/components/examples/Persona"}}}}}},
    "examples": {"Persona": {"value": {"nombre": "Persona inventada", "$ref": "https://example.invalid/es-un-dato-no-una-referencia"}}},
    "schemas": {
      "Persona": {
        "type": "object", "required": ["nombre"],
        "properties": {"nombre": {"type": ["string", "null"]}, "progenitor": {"$ref": "#/components/schemas/Persona"}, "example": {"$ref": "#/components/schemas/Nombre"}},
        "$defs": {"a/b~c": {"type": "string"}},
        "additionalProperties": false
      },
      "Nombre": {"$ref": "#/components/schemas/Persona/$defs/a~1b~0c"},
      "Libre": true,
      "Vacio": false
    }
  }
}
