{
  "name": "drawio-contracts-local",
  "version": "1.0.0",
  "private": true,
  "scarfSettings": {
    "enabled": false
  },
  "type": "module",
  "engines": {
    "node": "24.18.x",
    "npm": "11.16.x"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "npm run check && npm run test:unit && npm run build && playwright test",
    "test:unit": "node scripts/build-tests.mjs && node --test tests/unit/*.test.mjs",
    "test:browser-install": "playwright install chromium",
    "test:startup": "node tests/runtime/startup.mjs",
    "test:corpus": "node scripts/build-tests.mjs && node tests/runtime/public-examples.mjs",
    "test:corpus:browser": "npm run test:corpus && node tests/runtime/public-examples-browser.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@apidevtools/openapi-schemas": "2.1.0",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "3.0.1",
    "swagger-ui-dist": "5.33.2",
    "yaml": "2.9.1"
  }
}
